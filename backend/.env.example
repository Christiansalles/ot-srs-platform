PORT=3000
# Credenciais ilustrativas para desenvolvimento local.
DATABASE_URL=postgresql://ot:ot@localhost:5432/ot_srs
# Diretório para PDFs enviados e carregados pelo seed (relativo ao backend ou absoluto).
UPLOADS_DIR=./uploads
# Origem liberada no CORS (URL do front). Sem valor, libera qualquer origem.
CORS_ORIGIN=
# Credenciais fictícias para desenvolvimento local; substitua por valores próprios.
ADMIN_EMAIL=admin@observatorio.local
ADMIN_SENHA=senha-admin-local-nao-usar-em-producao
JWT_SECRET=jwt-secret-local-nao-usar-em-producao
