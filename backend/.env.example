PORT=3000
# Credenciais ilustrativas para desenvolvimento local.
DATABASE_URL=postgresql://ot:ot@localhost:5432/ot_srs
# Origem liberada no CORS (URL do front). Sem valor, libera qualquer origem.
CORS_ORIGIN=
# Segredo local para assinar os tokens de autenticação; troque por um valor forte fora do desenvolvimento.
JWT_SECRET=local-development-only-change-this-secret
